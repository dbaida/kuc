doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title AI Agents for Revenue Teams
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet", href="css/main.css")
  body
    section.ai-agents-section
      .ai-agents-section__header
        h2 AI agents for revenue teams
        p Empower your team with intelligent agents designed to streamline operations and boost, revenue.
      
      .ai-agents-section__grid
        // Card 1
        article.card
          .card__content
            h3.card__title Rapid Answers
            p.card__description Get instant, accurate responses to complex technical and product inquiries, reducing wait times and improving client satisfaction.
            .card__footer
              span Learn more
              .btn-arrow
                svg(viewBox="0 0 24 24")
                  path(d="M5 12h14M12 5l7 7-7 7")
        
        // Card 2
        article.card
          .card__content
            h3.card__title Automate RFPs
            p.card__description Seamlessly auto-fill questionnaires and RFPs by retrieving historical data and standard approved responses in seconds.
            .card__footer
              span Learn more
              .btn-arrow
                svg(viewBox="0 0 24 24")
                  path(d="M5 12h14M12 5l7 7-7 7")
        
        // Card 3
        article.card
          .card__content
            h3.card__title Revenue Enablement
            p.card__description Distribute key insights, battlecards, and sales materials instantly to your representatives directly within their workflow.
            .card__footer
              span Learn more
              .btn-arrow
                svg(viewBox="0 0 24 24")
                  path(d="M5 12h14M12 5l7 7-7 7")
